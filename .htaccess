# ==============================================================================
# iboltnetworks E-Commerce - Apache / Hostinger Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Protect sensitive environment and source files
<FilesMatch "^\.(env|git|htaccess)">
    Require all denied
</FilesMatch>

# Protect configuration, database dumps, backups, archives and sensitive files from direct browser access
<FilesMatch "(?i)\.(sql|log|md|example|bak|conf|ini|sh|yml|yaml|dump|tar|gz|zip)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # Security headers
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Ensure index.php takes precedence over index.html
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS in production (preserves local development on localhost/127.0.0.1)
    # Checks both direct HTTPS and reverse proxy (Hostinger / Cloudflare) SSL headers to prevent redirect loops
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Prevent direct access to app/, includes/ and database/ PHP files if accessed via URL
    RewriteRule ^app/.*$ - [F,L]
    RewriteRule ^includes/.*$ - [F,L]
    RewriteRule ^database/.*$ - [F,L]

    # Prevent duplicate content: redirect direct index.html requests to index.php
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ [^\ ]*index\.html(\?[^\ ]*)?\ HTTP/
    RewriteRule ^index\.html$ index.php [R=301,L]

    # Route legacy product.html and products.html requests to dynamic PHP handlers
    RewriteRule ^product\.html$ product.php [QSA,L]
    RewriteRule ^products\.html$ products.php [QSA,L]
</IfModule>
